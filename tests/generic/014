#!/bin/bash
# SPDX-License-Identifier: MIT or GPL-2.0-only

. common/fio_common
. common/loop_common

echo -e "\trun fio with quiesce/recover cycles, server returning commands"

BS=4k
RW=randrw
JOBS=4
RT=$((TRUNTIME * 4))
CYCLES=4
RES=0

if ! __ublk_has_feature QUIESCE; then
	echo -e "\tkernel has no QUIESCE, skipping"
	exit 0
fi

ublk_run_quiesce_test()
{
	local mark="ublk quiesce-repark $T_TYPE_PARAMS"

	echo "$mark" > /dev/kmsg

	local dev=`__create_ublk_dev`
	if [ "$dev" == "/dev/ublkb-unknown" ]; then
		echo -e "\tadd failed($T_TYPE_PARAMS)"
		RES=1
		return
	fi

	echo -e "\trun fio on $dev(ublk add $T_TYPE_PARAMS) with $CYCLES quiesce cycles"
	__run_fio_libaio $dev $BS $RW $JOBS $RT > /dev/null 2>&1 &
	local fio_pid=$!

	local cycle
	for cycle in `seq $CYCLES`; do
		# the quiesce must land while the server still has commands
		# parked in the driver, at a different point each cycle
		sleep 0.$((RANDOM % 9 + 1))
		__ublk_quiesce_and_recover $dev || { RES=1; break; }
	done

	wait $fio_pid > /dev/null 2>&1

	__ublk_del_timeout $dev || RES=1
	__check_dmesg "$mark" || RES=1
}

FILE=`_create_loop_image "data" $LO_IMG_SZ`
for TYPE in "-t null -q 4 -d 128" "-t loop -q 2 -d 64 -f $FILE"; do
	export T_TYPE_PARAMS="$TYPE --quiesce -r 1"
	ublk_run_quiesce_test
done
_remove_loop_image $FILE

exit $RES
