FIO_OUTPUT="$TEST_DIR/.fio_perf"

_fio_perf_report() {
	# If there is more than one group, we don't know what to report.
	if [[ $(wc -l < "$FIO_OUTPUT") -gt 1 ]]; then
		echo "_fio_perf: too many terse lines" >&2
		return
	fi

	local name field value
	for name in "${FIO_PERF_FIELDS[@]}"; do
		field="${FIO_TERSE_FIELDS["$name"]}"
		if [[ -z $field ]]; then
			echo "_fio_perf: unknown fio terse field '$name'" >&2
			continue
		fi
		value="$(cut -d ';' -f "$field" "$FIO_OUTPUT")"
		TEST_RUN["$FIO_PERF_PREFIX$name"]="$value"
	done
}

__run_fio_libaio() {
	DEVS=$1
	BS=$2
	RW=$3
	JOBS=$4
	RTIME=$5

	QD=128
	BATCH=16
	FIO=fio

	$FIO --output=$FIO_OUTPUT --output-format=terse --terse-version=4 --group_reporting=1 \
		--bs=$BS --ioengine=libaio \
        --iodepth=$QD \
        --iodepth_batch_submit=$BATCH \
        --iodepth_batch_complete_min=$BATCH \
        --filename=$DEVS --gtod_reduce=1 \
        --direct=1 --runtime=$RTIME --numjobs=$JOBS --rw=$RW \
        --name=test $EXTRA_FIO_OPTS > /dev/null 2>&1
}

__ublk_loop_backing_file() {
	eval $UBLK list > ${UBLK_TMP}
	file=`cat ${UBLK_TMP} | grep "loop" | awk '{print $2}' | awk -F "," '{print $1}' | awk -F ":" '{print $2}'`
	echo $file | xargs
}

__ublk_dev_id() {
	local dev=$1
	dev_id=`echo "$dev" | awk '{print substr($1, 11)}'`
	echo "$dev_id"
}

__ublk_get_pid() {
	local dev=$1
	local dev_id=`__ublk_dev_id $dev`

	eval $UBLK list -n $dev_id > ${UBLK_TMP}
	pid=`cat ${UBLK_TMP} | grep "pid" | awk '{print $7}'`
	# a device that was never started reports -1 here, and the suite runs
	# as root, where 'kill -9 -1' takes down the whole machine
	[ "$pid" -gt 0 ] 2>/dev/null || return 1
	echo $pid
}

__ublk_get_queue_tid() {
	local dev=$1
	local qid=$2
	local dev_id=`__ublk_dev_id $dev`

	eval $UBLK list -n ${dev_id} > ${UBLK_TMP}
	q_tid=`cat ${UBLK_TMP} | grep "queue ${qid}" | awk '{print $4}'`
	echo $q_tid
}

__ublk_get_dev_state() {
	local dev=$1
	local dev_id=`__ublk_dev_id $dev`

	eval $UBLK list -n ${dev_id} > ${UBLK_TMP}
	state=`cat ${UBLK_TMP} | grep "state" | awk '{print $9}'`
	echo $state
}

__run_fio_perf() {
	__run_fio_libaio $@
	_fio_perf_report
}

__remove_ublk_dev_return() {
	local dev="$1"
	if [ "$dev" == "*" ]; then
		eval $UBLK del -a
	else
		dev_id=`__ublk_dev_id $dev`
		eval $UBLK del -n "$dev_id"
	fi
	RES=$?
	udevadm settle
	echo $RES
}

__remove_ublk_dev() {
	__remove_ublk_dev_return $@ > /dev/null 2>&1
}

# A teardown race shows up either as a del that never returns or as a splat
# from a freed request. Both have to be caught: a del bounded by timeout(1)
# tells a hang from a slow machine, and the kernel log covers the races that
# complete.
DMESG_BAD='BUG:|WARNING:|blocked for more than|circular locking|refcount_t:|KCSAN:'
DEL_TIMEOUT=30

# 'ublk features' names one flag per line; the teardown arms that need a
# flag the running kernel lacks are skipped rather than failed
__ublk_has_feature()
{
	eval $UBLK features 2>/dev/null | grep -q "$1"
}

__ublk_del_timeout()
{
	local dev=$1
	local dev_id=`__ublk_dev_id $dev`
	local res

	timeout $DEL_TIMEOUT $UBLK del -n $dev_id > /dev/null 2>&1
	res=$?
	udevadm settle

	if [ $res -eq 124 ]; then
		echo -e "\tdelete $dev wedged after ${DEL_TIMEOUT}s"
		ps -eLf | grep ublk
		return 1
	fi
	if [ $res -ne 0 ]; then
		echo -e "\tdelete $dev failed($res)"
		return 1
	fi
	return 0
}

# Everything the kernel logged since the caller wrote its marker. No marker
# means the ring buffer wrapped; scan all of it rather than nothing.
__check_dmesg()
{
	local mark=$1
	local from=`dmesg | grep -n "$mark" | tail -1 | cut -d: -f1`
	local out

	[ -z "$from" ] && from=0
	out=`dmesg | tail -n +$((from + 1)) | grep -E "$DMESG_BAD"`
	[ -z "$out" ] && return 0
	echo "$out" | sed 's/^/\t\t/'
	return 1
}

# One teardown iteration on a device built from $T_TYPE_PARAMS: drive IO,
# land a del in the middle of it, take the verdict from the del itself plus
# everything the kernel logged since the marker.
__ublk_run_del_mid_io()
{
	local tag=$1
	local cnt=$2
	local bs=$3
	local rw=$4
	local jobs=$5
	local runtime=$6
	local mark="ublk $tag $cnt $T_TYPE_PARAMS"
	local res=0

	echo "$mark" > /dev/kmsg

	local dev=`__create_ublk_dev`
	if [ "$dev" == "/dev/ublkb-unknown" ]; then
		echo -e "\tadd failed($T_TYPE_PARAMS)"
		return 1
	fi

	echo -e "\trun fio on $dev(ublk add $T_TYPE_PARAMS) with deleting dev $cnt"
	__run_fio_libaio $dev $bs $rw $jobs $runtime > /dev/null 2>&1 &
	local fio_pid=$!

	# del has to land while fio is still driving the queue, at a different
	# point each iteration: once IO has quiesced the window is closed.
	sleep 0.$((RANDOM % 9 + 1))

	__ublk_del_timeout $dev || res=1

	# fio sees EIO once the device is gone, which is the expected outcome
	wait $fio_pid > /dev/null 2>&1

	__check_dmesg "$mark" || res=1
	return $res
}

__ublk_wait_dev_state()
{
	local dev=$1
	local exp_state=$2
	local secs=0
	local state=`__ublk_get_dev_state $dev`

	while [ $secs -lt 30 ] && [ "$state" != "$exp_state" ]; do
		sleep 1
		state=`__ublk_get_dev_state $dev`
		let secs++
	done
	echo $state
}

# Quiesce the device and bring it back. A quiesce that never returns is one
# of the failures this covers, so it is bounded the way the del is.
__ublk_quiesce_and_recover()
{
	local dev=$1
	local dev_id=`__ublk_dev_id $dev`
	local state
	local res

	timeout $DEL_TIMEOUT $UBLK quiesce -n $dev_id > /dev/null 2>&1
	res=$?
	if [ $res -eq 124 ]; then
		echo -e "\tquiesce $dev wedged after ${DEL_TIMEOUT}s"
		ps -eLf | grep ublk
		return 1
	fi
	if [ $res -ne 0 ]; then
		echo -e "\tquiesce $dev failed($res)"
		return 1
	fi

	state=`__ublk_wait_dev_state $dev "QUIESCED"`
	if [ "$state" != "QUIESCED" ]; then
		echo -e "\t$dev didn't reach QUIESCED($state)"
		return 1
	fi

	state=`recover_ublk_dev_and_wait $dev`
	if [ "$state" != "LIVE" ]; then
		echo -e "\t$dev isn't recovered($state)"
		return 1
	fi
	return 0
}

__find_free_ublk_id()
{
	for id in `seq 0 64`; do
		[ -c /dev/ublkc${id} ] && continue
		echo $id
		break
	done
	[ $id == "64" ] && echo "-"
}

__create_ublk_dev()
{
	id=`__find_free_ublk_id`
	[ ${id} == "-" ] && echo "no free ublk device nodes" && exit -1
	eval $UBLK add ${T_TYPE_PARAMS} -n $id > /dev/null 2>&1
	udevadm settle
	if [ -b /dev/ublkb${id} ]; then
		echo "/dev/ublkb${id}"
	else
		echo "/dev/ublkb-unknown"
	fi
}

__recover_ublk_dev()
{
	local dev=$1
	local dev_id=`__ublk_dev_id $dev`

	eval $UBLK recover -n $dev_id > /dev/null 2>&1
	RES=$?
	echo $RES
}

# kill the ublk daemon and return ublk device state
__ublk_kill_daemon()
{
	local dev=$1
	local exp_state=$2
	local secs=0
	local daemon_pid=`__ublk_get_pid $dev`
	local state=`__ublk_get_dev_state $dev 0`

	if [ -z "$daemon_pid" ]; then
		echo "no-daemon"
		return
	fi

	while [ $secs -lt 30 ] && [ "$state" != "$exp_state" ]; do
		kill -9 $daemon_pid > /dev/null 2>&1
		sleep 1
		state=`__ublk_get_dev_state $dev 0`
		let secs++
	done
	echo $state
}

recover_ublk_dev_and_wait()
{
	local dev=$1
	local secs=0
	local state=""

	while [ $secs -lt 15 ]; do
		__recover_ublk_dev $dev > /dev/null 2>&1
		state=`__ublk_get_dev_state $dev 0`
		[ "$state" == "LIVE" ] && break
		sleep 1
		let secs++
	done
	echo $state
}

__get_cpu_utils()
{
	local user_cpu=`echo ${TEST_RUN["user cpu"]} | awk -F "." '{print $1}'`
	local sys_cpu=`echo ${TEST_RUN["system cpu"]} | awk -F "." '{print $1}'`
	echo "cpu_util(${user_cpu}% ${sys_cpu}%)"
}

__run_dev_perf_no_create()
{
	local TYPE=$1
	local JOBS=$2
	local DEV=$3
	local RT=$TRUNTIME
	local BS=4k
	local FIO_PERF_FIELDS=("read iops" "write iops" "user cpu" "system cpu")

	RW="randwrite"
	__run_fio_perf $DEV $BS $RW $JOBS 20
	cpu_util=`__get_cpu_utils`
	echo -e "\t$RW($BS): jobs $JOBS, iops ${TEST_RUN["write iops"]}, $cpu_util"

	RW="randread"
	__run_fio_perf $DEV $BS $RW $JOBS $RT
	cpu_util=`__get_cpu_utils`
	echo -e "\t$RW($BS): jobs $JOBS, iops ${TEST_RUN["read iops"]}, $cpu_util"

	RW="randrw"
	__run_fio_perf $DEV $BS $RW $JOBS $RT
	cpu_util=`__get_cpu_utils`
	echo -e "\t$RW($BS): jobs $JOBS, iops read ${TEST_RUN["read iops"]} write ${TEST_RUN["write iops"]}, $cpu_util"

	RW="rw"
	BS=64k
	__run_fio_perf $DEV $BS $RW $JOBS $RT
	cpu_util=`__get_cpu_utils`
	echo -e "\t$RW($BS): jobs $JOBS, iops read ${TEST_RUN["read iops"]} write ${TEST_RUN["write iops"]}, $cpu_util"

	RW="rw"
	BS=512k
	__run_fio_perf $DEV $BS $RW $JOBS $RT
	cpu_util=`__get_cpu_utils`
	echo -e "\t$RW($BS): jobs $JOBS, iops read ${TEST_RUN["read iops"]} write ${TEST_RUN["write iops"]}, $cpu_util"

	echo ""
}

__run_dev_perf()
{
	JOBS=$1

	DEV=`__create_ublk_dev`

	echo -e "\tublk add ${T_TYPE_PARAMS}, fio: ($DEV libaio dio io jobs($JOBS))..."
	__run_dev_perf_no_create "ublk" $JOBS $DEV

	__remove_ublk_dev $DEV
}

_create_null_image()
{
	echo ""
}

_create_image()
{
	local type=$1

	shift 1

	eval _create_${type}_image $@
}

_remove_null_image()
{
	echo "nothing" > /dev/null
}

_remove_image()
{
	local type=$1
	shift 1
	eval _remove_${type}_image $@
}
